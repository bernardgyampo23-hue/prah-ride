rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check / connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rides collection
    match /rides/{rideId} {
      allow read, write: if true;
    }

    // Complaints / Support Tickets collection (including guest inquiries)
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Driver locations collection for real-time tracking
    match /driver_locations/{driverId} {
      allow read, write: if true;
    }

    // Passenger security trip codes collection
    match /trip_codes/{codeId} {
      allow read, write: if true;
    }
  }
}

